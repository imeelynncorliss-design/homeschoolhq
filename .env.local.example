# HomeschoolReady local environment example
# Copy to .env.local and fill in local/dev values. Do not commit real secrets.

# Required: Supabase client/browser access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for server-side admin routes and background sync jobs
SUPABASE_SERVICE_ROLE_KEY=

# Required for auth redirects in local/dev environments
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers / generation features
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Email / invitations
RESEND_API_KEY=

# Calendar integrations
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/outlook
CALENDAR_SYNC_LOOKBACK_DAYS=7
CALENDAR_SYNC_LOOKAHEAD_DAYS=90

# Feature flags / local tooling
NEXT_PUBLIC_BETA_FEEDBACK_ENABLED=false
NEXT_PUBLIC_DEV_TOOLS=false
